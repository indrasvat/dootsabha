#!/usr/bin/env bash
# Simulates claude CLI for smoke tests — no API calls
set -euo pipefail
PROMPT="" FORMAT="" MODEL="claude-opus-4-8" ERROR=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -p) PROMPT="$2"; shift 2 ;;
    --output-format) FORMAT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --dangerously-skip-permissions) shift ;;
    --no-session-persistence) shift ;;
    --error) ERROR="$2"; shift 2 ;;  # test hook: force error
    *) PROMPT="${PROMPT:-$1}"; shift ;;
  esac
done

# JSON-escape a string so prompts containing quotes/newlines/backslashes cannot
# produce invalid JSON. council/refine embed prior agent responses in the prompt,
# so multi-line input is the normal case, not an edge case.
json_str() { python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read()))'; }

[[ -n "$ERROR" ]] && { echo "Error: $ERROR" >&2; exit 3; }
if [ "$FORMAT" = "json" ]; then
  RESULT_JSON=$(printf '%s' "Mock: $PROMPT" | json_str)
  MODEL_JSON=$(printf '%s' "$MODEL" | json_str)
  printf '{"result":%s,"session_id":"mock_123","cost_usd":0.001,"model":%s,"duration_ms":150}\n' "$RESULT_JSON" "$MODEL_JSON"
else
  echo "Mock response to: $PROMPT"
fi
