#!/usr/bin/env bash
# Simulates codex CLI for smoke tests — no API calls (emits JSONL event stream)
set -euo pipefail
PROMPT=""
while [[ $# -gt 0 ]]; do
  case $1 in
    exec) shift ;;
    --json) shift ;;
    --sandbox) shift 2 ;;
    --ephemeral) shift ;;
    --skip-git-repo-check) shift ;;
    # The real provider always passes --model before the prompt. Without this
    # case the mock took "--model" AS the prompt, so every codex-backed
    # assertion was checking a flag name rather than the text under test.
    --model|-m) shift 2 ;;
    -c) shift 2 ;;  # config overrides like model_reasoning_effort=medium
    *) PROMPT="${PROMPT:-$1}"; shift ;;
  esac
done

# Test hook: simulate a slow provider so timeout scoping can be exercised
# end-to-end (GitHub issue #20). Unset in normal runs, so this is a no-op.
sleep "${MOCK_CODEX_DELAY:-0}"

# JSON-escape a string so prompts containing quotes/newlines/backslashes cannot
# produce invalid JSON. council/refine embed prior agent responses in the prompt,
# so multi-line input is the normal case, not an edge case.
json_str() { python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read()))'; }

TEXT_JSON=$(printf '%s' "Mock: $PROMPT" | json_str)
echo '{"type":"thread.started","thread_id":"mock-thread-1"}'
echo '{"type":"turn.started"}'
printf '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":%s}}\n' "$TEXT_JSON"
echo '{"type":"turn.completed","usage":{"input_tokens":100,"output_tokens":50}}'
